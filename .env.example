# ---------------------------------------------------------------------------
# SP-01 Dengue Intelligence · configuración de entorno
# Copie este archivo como .env y ajuste los valores. NUNCA versionar el .env real.
# ---------------------------------------------------------------------------

# Aplicación
APP_NAME=SP-01 Dengue Intelligence
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://127.0.0.1:8000

# Seguridad (obligatorio en producción: genere uno con `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Base de datos. Para PostgreSQL/PostGIS use:
# DATABASE_URL=postgresql+psycopg2://dengai:dengai@db:5432/dengai
DATABASE_URL=
POSTGIS_ENABLED=false

# Orígenes permitidos por CORS (separados por coma en la variable de entorno)
CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Cuenta administradora inicial (se crea solo si la base está vacía)
BOOTSTRAP_ADMIN_EMAIL=admin@dengai.unt.edu.pe
BOOTSTRAP_ADMIN_PASSWORD=Admin#Dengue2025
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Demo#Dengue2025

# Machine Learning
ML_DEFAULT_TRIALS=50
ML_MAX_TRIALS=150
ML_VALIDATION_WEEKS=26
ML_TEST_WEEKS=26
ML_MAX_LAG=12
ML_MODELS_DIR=data/models

# MLflow (opcional). Si se deja vacío se usa data/mlruns cuando MLflow está instalado.
MLFLOW_TRACKING_URI=
MLFLOW_ENABLED=false

# Integraciones externas
LIVE_INTEGRATIONS_ENABLED=false
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/weekly/point
NASA_POWER_TIMEOUT=20

# Capa de lenguaje: grounded_template (determinista, sin costo) u openai_compatible
LLM_PROVIDER=grounded_template
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=5

# Reportes
REPORTS_DIR=data/reports
REVIEWER_EMAIL=comite@dengai.unt.edu.pe

# Credenciales para los workflows de n8n (se leen desde el entorno de n8n, no del backend)
DENGAI_BASE_URL=http://backend:8000/api/v1
DENGAI_USER=admin@dengai.unt.edu.pe
DENGAI_PASSWORD=Admin#Dengue2025
DENGAI_ALERT_WEBHOOK=
