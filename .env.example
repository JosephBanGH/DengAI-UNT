# ---------------------------------------------------------------------------
# SP-01 Dengue Intelligence · configuración de entorno
# Copie este archivo como .env y ajuste los valores. NUNCA versionar el .env real.
# ---------------------------------------------------------------------------

# Aplicación
APP_NAME=SP-01 Dengue Intelligence
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://127.0.0.1:8000

# Seguridad (obligatorio en producción: genere uno con `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Base de datos. Para PostgreSQL/PostGIS use:
# DATABASE_URL=postgresql+psycopg2://dengai:dengai@db:5432/dengai
DATABASE_URL=
POSTGIS_ENABLED=false

# Orígenes permitidos por CORS (separados por coma en la variable de entorno)
CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Cuenta administradora inicial (se crea solo si la base está vacía)
BOOTSTRAP_ADMIN_EMAIL=admin@dengai.unt.edu.pe
BOOTSTRAP_ADMIN_PASSWORD=Admin#Dengue2025
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Demo#Dengue2025

# Machine Learning
ML_DEFAULT_TRIALS=50
ML_MAX_TRIALS=150
ML_VALIDATION_WEEKS=26
ML_TEST_WEEKS=26
ML_MAX_LAG=12
ML_MODELS_DIR=data/models
DATA_MODE=auto

# MLflow (tracking de experimentos)
# En host local: http://localhost:5050 | En red Docker compose: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_ENABLED=true
MLFLOW_EXPERIMENT_NAME=SP01-Dengue-Intelligence

# Almacenamiento de objetos (MinIO)
# En host local: localhost:9000 | En red Docker compose: minio:9000
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dengai
MINIO_SECRET_KEY=dengai-minio
MINIO_BUCKET=dengai
MINIO_SECURE=false

# Integraciones externas
LIVE_INTEGRATIONS_ENABLED=false
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT=20
MINSA_DENGUE_RAW_CSV=data/raw/minsa/datos_abiertos_dengue.csv
MINSA_START_YEAR=2015
MINSA_END_YEAR=2024
RAW_DATA_DIR=data/raw

# Capa de lenguaje: grounded_template (determinista, sin costo), gemini o openai_compatible
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=5

# Reportes
REPORTS_DIR=data/reports
REVIEWER_EMAIL=comite@dengai.unt.edu.pe

# Credenciales para los workflows de n8n (se leen desde el entorno de n8n, no del backend)
DENGAI_BASE_URL=http://backend:8000/api/v1
DENGAI_USER=admin@dengai.unt.edu.pe
DENGAI_PASSWORD=Admin#Dengue2025
DENGAI_ALERT_WEBHOOK=
